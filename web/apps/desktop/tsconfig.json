{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@renderer/*": ["./src/renderer/*"],
      "@main/*": ["./src/main/*"],
      "@vs/shared": ["../../packages/shared/src/index.ts"],
      "@vs/shared/*": ["../../packages/shared/src/*"],
      "@vs/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "electron-builder.config.ts"]
}
