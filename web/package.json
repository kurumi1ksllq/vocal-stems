{
  "name": "vocal-stems-web",
  "private": true,
  "version": "0.1.0",
  "description": "干声分离台 —— 去伴奏 / 去和声 / 去混响 的桌面控制台",
  "author": "kurumi1ksllq",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "tsc -b",
    "server": "node scripts/run-server.mjs",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"pnpm server\" \"pnpm dev\"",
    "verify": "biome check . && tsc -b",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "electron:dev": "concurrently -n api,web,app -c cyan,magenta,yellow \"pnpm server\" \"pnpm dev\" \"wait-on http://127.0.0.1:5178 && cross-env VITE_DEV_URL=http://127.0.0.1:5178 electron electron/main.cjs\"",
    "electron:start": "electron electron/main.cjs",
    "dist": "pnpm build && pnpm runtime:prepare && electron-builder --win --x64",
    "dist:dir": "pnpm build && pnpm runtime:prepare && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-plugin-react-compiler": "^19.0.0-beta-af1b7da-20250417",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "dev.kurumi.vocal-stems",
    "productName": "干声分离台",
    "copyright": "Copyright © 2026 kurumi1ksllq",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "asar": true,
    "compression": "normal"
  }
}
