{
  "name": "vocal-stems",
  "private": true,
  "license": "LicenseRef-PolyForm-Strict-1.0.0",
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @vs/desktop dev",
    "build": "pnpm --filter @vs/desktop build",
    "preview": "pnpm --filter @vs/desktop preview",

    "story": "pnpm --filter @vs/ui story",
    "story:build": "pnpm --filter @vs/ui story:build",

    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "pnpm -r --no-bail exec tsc --noEmit",
    "verify": "biome ci . && pnpm typecheck",

    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",

    "db:generate": "pnpm --filter @vs/shared db:generate",
    "db:migrate": "pnpm --filter @vs/shared db:migrate",

    "analyze": "pnpm --filter @vs/desktop analyze",

    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dist": "pnpm build && pnpm prepare:runtime && pnpm --filter @vs/desktop dist:zip",
    "dist:dir": "pnpm build && pnpm prepare:runtime && pnpm --filter @vs/desktop dist"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "jsdom": "^25.0.1",
    "lefthook": "^2.2.2",
    "msw": "^3.0.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
